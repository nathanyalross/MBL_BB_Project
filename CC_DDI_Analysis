        dataset_name = None
        for key in f['Data'].keys():
            #Adjust this for appropriate filename
            #if re.match(f'R{run}+_S2+_CC_IV_DDI', key): #For Sutter
            if re.match(f'R{run}+_S1+_CC_DDI', key): #For HEKA
                dataset_name = f'Data/{key}'
                break

    with h5py.File(file_path, 'r') as f:
        print(dataset_name)
        data = f[dataset_name][:]

        # Check data shape and available sweeps
        total_sweeps = data.shape[1]
        print(f"Total available sweeps in dataset: {total_sweeps}")

        # Filter sweep numbers to only include existing sweeps
        valid_sweep_numbers = [s for s in sweep_numbers if s <= total_sweeps]
        invalid_sweep_numbers = [s for s in sweep_numbers if s > total_sweeps]

        if invalid_sweep_numbers:
            print(f"Warning: The following sweep numbers don't exist and will be skipped: {invalid_sweep_numbers}")

        if not valid_sweep_numbers:
            print("Error: No valid sweep numbers found!")
            return []

        # Store results for all sweeps
        all_results = []

        for sweep_number in valid_sweep_numbers:
            try:
                # Convert sweep number to index (1-indexed to 0-indexed)
                sweep_index = sweep_number - 1

                # Create time axis (assuming same sampling rate: 20 kHz = 50 μs per sample)
                # Create time axis (assuming same sampling rate: 20 kHz = 50 μs per sample)
                num_samples = data.shape[0]  # Get actual number of samples from data
                time_axis = np.arange(num_samples) * 5e-5  # 10e-5 seconds per sample
                time_s = time_axis  # Time in seconds
                voltage_mV = data[:, sweep_index] * 1000  # Convert to mV
                print(voltage_mV)

                # Rest of your existing code for measurements...
                # [Include all the existing measurement code here]

                # ==============================================================================
                # MEASUREMENTS
                # ==============================================================================

                # 1. Average Y value from 0 to 1 s
                mask_0_1s = (time_s >= 0) & (time_s <= 1)
                avg_0_1s = np.mean(voltage_mV[mask_0_1s])

                # 2. Average Y value at 2.49 to 2.5 s
                mask_2_49_2_5s = (time_s >= 2.49) & (time_s <= 2.5)
                avg_2_49_2_5s = np.mean(voltage_mV[mask_2_49_2_5s])

                # 3. Average Y value at 2.99 to 3 s
                mask_2_99_3s = (time_s >= 2.99) & (time_s <= 3)
                avg_2_99_3s = np.mean(voltage_mV[mask_2_99_3s])

                # 4. Average Y value at 3.99 to 4 s
                mask_3_99_4s = (time_s >= 3.99) & (time_s <= 4)
                avg_3_99_4s = np.mean(voltage_mV[mask_3_99_4s])

                # 5. Count action potentials (threshold: -30 mV)
                threshold = -30  # mV

                # Find peaks that cross the threshold
                above_threshold = voltage_mV > threshold

                # Find transitions from below to above threshold
                crossings = np.diff(above_threshold.astype(int))
                rising_edges = np.where(crossings == 1)[0]

                # Count action potentials
                action_potential_count = len(rising_edges)

                # Get the times of action potentials for annotation
                ap_times = time_s[rising_edges] if len(rising_edges) > 0 else []

                # 6. AUC calculations for afterhyperpolarization (AHP) using 0-1 s average as reference baseline
                # AUC from 2 s to 2.5 s
                mask_2_to_2_5s = (time_s >= 2.0) & (time_s <= 2.5)
                if np.any(mask_2_to_2_5s):
                    time_2_to_2_5s = time_s[mask_2_to_2_5s]
                    baseline_2_to_2_5s = np.full_like(time_2_to_2_5s, avg_0_1s)
                    actual_data_2_to_2_5s = voltage_mV[mask_2_to_2_5s]
                    auc_2_to_2_5s = np.trapezoid(actual_data_2_to_2_5s - baseline_2_to_2_5s, time_2_to_2_5s)
                else:
                    auc_2_to_2_5s = 0

                # AUC from 2 s to 3 s
                mask_2_to_3s = (time_s >= 2.0) & (time_s <= 3.0)
                if np.any(mask_2_to_3s):
                    time_2_to_3s = time_s[mask_2_to_3s]
                    baseline_2_to_3s = np.full_like(time_2_to_3s, avg_0_1s)
