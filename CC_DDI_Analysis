                    'auc_2_to_4s': auc_2_to_4s,
                    'auc_2_to_8s': auc_2_to_8s
                }
                all_results.append(sweep_results)

                # ==============================================================================
                # PRINT MEASUREMENTS FOR THIS SWEEP
                # ==============================================================================
                print(f"\n{'=' * 50}")
                print(f"MEASUREMENTS FOR CC SWEEP {sweep_number}")
                print(f"{'=' * 50}")
                print(f"1. Average voltage (0-1 s): {avg_0_1s:.2f} mV")
                print(f"2. Average voltage (2.49-2.5 s): {avg_2_49_2_5s:.2f} mV")
                print(f"3. Average voltage (2.99-3 s): {avg_2_99_3s:.2f} mV")
                print(f"4. Average voltage (3.99-4 s): {avg_3_99_4s:.2f} mV")
                print(f"5. Action potential count (threshold: {threshold} mV): {action_potential_count}")
                if len(ap_times) > 0:
                    print(f"   Action potential times: {[f'{t:.3f}' for t in ap_times]} s")
                print(f"6. AHP AUC relative to 0-1 s baseline (afterhyperpolarization):")
