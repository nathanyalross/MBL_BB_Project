def save_results_to_csv(file_path, cc_results, output_filename=None, file_location=None):
    """Save all results to a CSV file with horizontal structure"""

    # Generate output filename if not provided
    if output_filename is None:
        base_name = os.path.splitext(os.path.basename(file_path))[0]
        output_filename = f"{base_name}_results.csv"

    # Add file location if provided
    if file_location is not None:
        # Create directory if it doesn't exist
        os.makedirs(file_location, exist_ok=True)
        output_filename = os.path.join(file_location, output_filename)

    # Get the base filename for the header
    file_name = os.path.splitext(os.path.basename(file_path))[0]

    with open(output_filename, 'w', newline='') as csvfile:
        writer = csv.writer(csvfile)

        # Create the complete header row with everything
        header_row = [file_name]

        # Add CC section
        header_row.extend([
            'CC Current Clamp',
            'Sweep No.',
            '0-1s avg (mV)',
            '2.49-2.5s (mV)',
            '2.99-3s (mV)',
            '3.99-4s (mV)',
            'AP count (#)',
            'AUC 2-2.5s (mV·s)',
            'AUC 2-3s (mV·s)',
            'AUC 2-4s (mV·s)',
            'AUC 2-8s (mV·s)'
        ])

        # Add new columns before CC section
        header_row.extend([
            'IC (pA)'
        ])

        writer.writerow(header_row)

        # Find the maximum number of sweeps across all datasets
        max_sweeps = len(cc_results)

        # Write data rows (starting from row 2)
        for i in range(max_sweeps):
            data_row = ['']  # Empty first column

            # CC data
            data_row.append('')  # Empty for section header column
            if i < len(cc_results):
                result = cc_results[i]
                data_row.extend([
                    result['sweep_number'],
                    f"{result['avg_0_1s']:.2f}",
                    f"{result['avg_2_49_2_5s']:.2f}",
                    f"{result['avg_2_99_3s']:.2f}",
                    f"{result['avg_3_99_4s']:.2f}",
                    result['action_potential_count'],
                    f"{result['auc_2_to_2_5s']:.4f}",
                    f"{result['auc_2_to_3s']:.4f}",
                    f"{result['auc_2_to_4s']:.4f}",
                    f"{result['auc_2_to_8s']:.4f}"
                ])
            else:
                data_row.extend(['', '', '', '', '', '', '', '', '', ''])  # Empty columns

            if i < len(cc_results):
                sweep_number = cc_results[i]['sweep_number']
                access_resistance = -20 + (sweep_number - 1) * 20  # If sweep_number starts at 1
                data_row.extend([
                    f"{access_resistance:.2f}"
                ])
            else:
                data_row.extend([''])


            writer.writerow(data_row)

        # Add some empty rows before action potential times
        writer.writerow([])
        writer.writerow([])
        writer.writerow([])
        writer.writerow([])
        writer.writerow([])

        # Action Potential Times Section
        writer.writerow(['Action Potential Times (s)'])
        writer.writerow(['Sweep No.', 'AP Times'])

        for result in cc_results:
            if result['ap_times'] is not None and len(result['ap_times']) > 0:
                ap_times_str = ', '.join([f"{t:.3f}" for t in result['ap_times']])
                writer.writerow([result['sweep_number'], ap_times_str])
            else:
                writer.writerow([result['sweep_number'], 'No action potentials'])

    print(f"\nResults saved to: {output_filename}")
    return output_filename

